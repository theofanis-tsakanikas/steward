{
  "//": "Generated by steward (src/steward/core/compile_assurance.py) from contracts/. Edit the contracts, then `make generate`.",
  "resource": {
    "google_data_loss_prevention_inspect_template": {
      "steward": {
        "description": "Kinds of personal data the contracts can declare and a value scan can find: msisdn, imsi, imei, email, iban, birth_date, address. A template cannot limit rows: the sample size belongs to the inspection job (core/sampling.py).",
        "display_name": "steward-inspect",
        "inspect_config": {
          "custom_info_types": [
            {
              "info_type": {
                "name": "STEWARD_IMSI"
              },
              "likelihood": "POSSIBLE",
              "regex": {
                "pattern": "\\b[0-9]{15}\\b"
              }
            }
          ],
          "include_quote": false,
          "info_types": [
            {
              "name": "DATE_OF_BIRTH"
            },
            {
              "name": "EMAIL_ADDRESS"
            },
            {
              "name": "IBAN_CODE"
            },
            {
              "name": "IMEI_HARDWARE_ID"
            },
            {
              "name": "PHONE_NUMBER"
            },
            {
              "name": "STREET_ADDRESS"
            }
          ],
          "limits": {
            "max_findings_per_item": 100,
            "max_findings_per_request": 1000
          },
          "min_likelihood": "POSSIBLE"
        },
        "parent": "projects/${var.project_id}/locations/${var.region}",
        "template_id": "steward-inspect"
      }
    },
    "google_dataplex_datascan": {
      "dq_analytics_weekly_usage_by_cell": {
        "data": {
          "resource": "//bigquery.googleapis.com/projects/${var.project_id}/datasets/analytics/tables/weekly_usage_by_cell"
        },
        "data_quality_spec": {
          "row_filter": "week_start >= DATE '1970-01-01'",
          "rules": [
            {
              "column": "country",
              "description": "Contract rule Q-ANA-001 (validity)",
              "dimension": "VALIDITY",
              "ignore_null": true,
              "name": "q-ana-001",
              "set_expectation": {
                "values": [
                  "GR",
                  "IT",
                  "DE"
                ]
              },
              "threshold": 1
            },
            {
              "column": "subscribers",
              "description": "Contract rule Q-ANA-002 (validity)",
              "dimension": "VALIDITY",
              "ignore_null": true,
              "name": "q-ana-002",
              "range_expectation": {
                "min_value": "5"
              },
              "threshold": 1
            }
          ],
          "sampling_percent": 100.0
        },
        "data_scan_id": "steward-dq-analytics-weekly-usage-by-cell",
        "description": "Rules from the analytics contract (version 2). On demand; reads at most 10000 rows or 32 MiB of the table.",
        "display_name": "steward data quality: analytics.weekly_usage_by_cell",
        "execution_identity": {
          "service_account": {
            "email": "${trimprefix(var.principals[\"group:data-platform@halverra.example\"], \"serviceAccount:\")}"
          }
        },
        "execution_spec": {
          "trigger": {
            "on_demand": {}
          }
        },
        "labels": {
          "dataset": "analytics",
          "table": "weekly_usage_by_cell"
        },
        "location": "${lower(var.location)}"
      },
